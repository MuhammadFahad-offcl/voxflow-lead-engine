{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build && pnpm run \"/^dev:/\"",
    "dev:compile": "tsc --build --watch --preserveWatchOutput",
    "dev:start": "node --env-file-if-exists=../../.env --enable-source-maps --watch dist/main.js",
    "dev:worker": "node --env-file-if-exists=../../.env --enable-source-maps --watch dist/worker.js",
    "worker": "node --env-file-if-exists=../../.env --enable-source-maps dist/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@hazeljs/agent": "2.0.13",
    "@hazeljs/core": "2.0.13",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "apify-client": "2.25.0",
    "cheerio": "1.2.0",
    "libphonenumber-js": "1.13.15",
    "pino": "10.4.0",
    "puppeteer-core": "25.16.0",
    "robots-parser": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@voxflow/shared": "workspace:*"
  }
}
