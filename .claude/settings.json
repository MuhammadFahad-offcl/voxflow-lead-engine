{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint --fix)",
      "Bash(pnpm knip)",
      "Bash(pnpm knip *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm evals)",
      "Bash(pnpm prisma validate)",
      "Bash(pnpm prisma format)",
      "Bash(pnpm prisma generate)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(pnpm prisma *)",
      "Bash(gh pr *)",
      "Bash(python -)",
      "Bash(pnpm db:generate)",
      "Bash(rm apps/api/test/zz-runstore-probe.int.spec.ts)",
      "Bash(grep -v \"^\\\\s*$\")",
      "Bash(grep -v \"^remote:\\\\s*$\")",
      "Bash(git checkout *)",
      "Bash(git merge *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(./.cloudflared/**)",
      "Read(./backups/**)",
      "Read(./data/**)",
      "Bash(cat .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(pnpm prisma migrate reset*)",
      "Bash(pnpm prisma db push*)",
      "Bash(pnpm knip --fix*)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm prisma migrate *)",
      "Bash(pnpm db:*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(docker *)"
    ]
  }
}
