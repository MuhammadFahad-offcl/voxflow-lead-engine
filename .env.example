# Copy to .env and fill in. .env is git-ignored and must never be committed or read by AI tools.
# Variables are validated at startup by apps/api/src/config/env.ts (Zod). Missing required keys stop the app.

# ── Mode ─────────────────────────────────────────────
# true = all external services replaced by fake adapters (no keys needed)
DEMO_MODE=true
NODE_ENV=development
# error | warn | info | debug (HazelJS's own logger prints nothing for other levels)
LOG_LEVEL=info
TZ_DISPLAY=Asia/Karachi

# ── Local services (docker compose) ─────────────────
# Pick your own password and use the same one in both lines. Postgres takes it only when its volume
# is first created; to change it later see README "Change the database password".
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://voxflow:change-me@localhost:5432/voxflow?schema=public
LIGHTPANDA_CDP_URL=ws://127.0.0.1:9222
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=3000

# ── Apify (discover) ────────────────────────────────
APIFY_TOKEN=
# Set after the Cycle 1 actor spike (ADR-0010)
APIFY_ACTOR_ID=

# ── Perplexity (search + embeddings) ────────────────
PERPLEXITY_API_KEY=
PERPLEXITY_EMBEDDING_MODEL=pplx-embed-v1-0.6b

# ── LLM ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Only needed for the Cycle 2 Urdu script comparison (FR-18)
OPENAI_API_KEY=

# ── Vapi (calls) — Cycle 3 ──────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
# Shared secret Vapi sends on tool calls and webhooks; generate with: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=
PUBLIC_HOOKS_BASE_URL=https://hooks.voxflow.agency

# ── Google Calendar (booking) — Cycle 4 ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Founder ─────────────────────────────────────────
FOUNDER_NAME=Fahad
# Used only to build the prefilled WhatsApp confirmation link
FOUNDER_WHATSAPP=

# ── Operations ──────────────────────────────────────
# Google Drive–synced folder for nightly pg_dump (NFR-12)
BACKUP_DIR=
